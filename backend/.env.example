DATABASE_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Coleta (RNF08) — valores padrão já cobrem o MVP
COLETA_INTERVALO_MINIMO_SEGUNDOS=2
COLETA_MAX_TENTATIVAS=3
COLETA_TIMEOUT_SEGUNDOS=15

# Coleta periódica (RF06) — intervalo em minutos, sem intervenção manual
COLETA_SCHEDULER_HABILITADO=true
COLETA_SCHEDULER_INTERVALO_MINUTOS=60
# Use só para teste local da recorrência (sobrescreve o intervalo em minutos)
# COLETA_SCHEDULER_INTERVALO_SEGUNDOS=10
COLETA_SCHEDULER_EXECUTAR_NO_STARTUP=false

# Alertas por e-mail (RF15, RF16)
ALERTA_QUEDA_MINIMA_PERCENTUAL=5
ALERTA_INTERVALO_REENVIOS_HORAS=24
ALERTA_SMTP_DRY_RUN=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USAR_TLS=true